---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<span class:list={["inline-flex items-center gap-2.5", className]}>
  <span
    class="grid size-9 place-items-center rounded-[10px] bg-ink font-serif text-[1.65rem] leading-none text-paper"
    aria-hidden="true"><span class="translate-y-[1px]">A</span></span
  >
  <span class="font-serif text-[1.6rem] leading-none tracking-tight">Avarch</span>
</span>
