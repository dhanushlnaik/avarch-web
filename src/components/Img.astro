---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import { resolveImage } from "../lib/images";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "width" | "height"> {
  src: string;
  alt: string;
  /** Largest CSS width the image is displayed at; drives the 1x/2x srcset. */
  w: number;
  /** Override for fluid layouts, e.g. "(min-width: 768px) 33vw, 100vw". */
  sizes?: string;
}

const { src, alt, w, sizes, loading = "lazy", decoding = "async", ...rest } = Astro.props;
const resolved = resolveImage(src);

const widths =
  typeof resolved === "string"
    ? []
    : [...new Set([w, w * 2].map((x) => Math.min(Math.round(x), resolved.width)))];
---
{typeof resolved === "string" ? (
  <img src={resolved} alt={alt} loading={loading} decoding={decoding} {...rest} />
) : (
  <Image
    src={resolved}
    alt={alt}
    width={widths.at(-1)}
    widths={widths}
    sizes={sizes ?? `${w}px`}
    loading={loading}
    decoding={decoding}
    {...rest}
  />
)}
