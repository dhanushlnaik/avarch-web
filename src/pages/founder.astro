---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Icon from "../components/Icon.astro";
import Img from "../components/Img.astro";
import CtaBand from "../components/CtaBand.astro";
import { founder, journey, contributions, talks, conversations, archive } from "../data/founder";

const years = [...new Set(talks.map((t) => t.year))];
---
<Layout
  title="Pooja Ranjan, Founder"
  description="Pooja Ranjan is the founder of Avarch and Herder-in-Chief of Ethereum Cat Herders. Her journey from learning Ethereum in 2016 to coordinating its network upgrades."
  image="/img/pooja-transparent.png"
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="grain pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-32 top-10 size-[36rem] rounded-full bg-iris-200/60 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative grid items-end gap-6 pt-16 md:grid-cols-[1.2fr_1fr] md:pt-20">
      <div class="pb-16 md:pb-24">
        <p class="eyebrow">Meet the founder</p>
        <h1 class="display mt-4 text-6xl sm:text-8xl">Pooja <em class="text-iris-600">Ranjan</em></h1>
        <p class="mt-4 text-lg text-ink-2">{founder.role}</p>
        <blockquote class="mt-10 max-w-xl border-l-2 border-ember-500 pl-6 font-serif text-2xl leading-snug sm:text-3xl">
          {founder.quote}
        </blockquote>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={founder.twitter} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-surface px-4 py-2.5 text-sm font-medium hover:border-ink">
            <Icon name="x" size={15} /> @poojaranjan19
          </a>
          <a href={founder.github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-surface px-4 py-2.5 text-sm font-medium hover:border-ink">
            <Icon name="github" size={16} /> poojaranjan
          </a>
        </div>
      </div>
      <Img
        src={founder.cutout}
        alt="Pooja Ranjan"
        w={448}
        loading="eager"
        fetchpriority="high"
        class="mx-auto w-full max-w-md self-end"
      />
    </div>
  </section>

  <!-- Journey -->
  <section class="container-page mt-24 grid gap-14 lg:grid-cols-[1fr_1.4fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHeader
        eyebrow="01 — The story"
        title="From learning to <em>building.</em>"
        lead="Pooja became part of the blockchain community in 2016 by learning about Ethereum. Since then her work has spanned publishing, infrastructure, EIP data and community coordination."
      />
    </div>
    <ol class="relative border-l border-line pl-8">
      {journey.map((j) => (
        <li class="relative pb-12 last:pb-0">
          <span class="absolute -left-[2.3rem] top-1.5 size-3 rounded-full border-2 border-paper bg-iris-600 ring-1 ring-iris-300"></span>
          <p class="font-mono text-sm text-iris-600">{j.year}</p>
          <h3 class="display mt-1 text-3xl">{j.title}</h3>
          <p class="mt-2 text-ink-2">{j.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Contributions -->
  <section class="mt-28 border-y border-line bg-surface py-20">
    <div class="container-page">
      <SectionHeader
        eyebrow="02 — Building Ethereum"
        title="Coordinating, documenting and explaining Ethereum's evolution"
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {contributions.map((c) => (
          <a href={c.href} target="_blank" rel="noopener" class="card group flex flex-col p-6 transition-all hover:-translate-y-0.5 hover:border-iris-300">
            <Img src={c.image} alt="" w={56} class="size-14 rounded-2xl border border-line bg-white object-cover" />
            <p class="eyebrow mt-6 !text-[0.68rem]">{c.kicker}</p>
            <h3 class="display mt-1 text-3xl">{c.title}</h3>
            <p class="mt-3 text-[0.95rem] text-ink-2">{c.body}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-medium text-iris-700">
              {c.cta} <Icon name="arrow-up-right" size={16} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Talks -->
  <section class="container-page mt-28">
    <SectionHeader
      eyebrow="03 — On stage"
      title="Speaking, sharing, shaping Ethereum"
      lead="Talks on protocol governance, the EIP process and community coordination — from Devcon to EDCON."
    />
    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter talks by year">
      <button type="button" data-year="all" aria-pressed="true" class="rounded-full border border-line-strong px-4 py-2 text-sm aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper">All</button>
      {years.map((y) => (
        <button type="button" data-year={y} aria-pressed="false" class="rounded-full border border-line-strong px-4 py-2 font-mono text-sm aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper">{y}</button>
      ))}
    </div>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-talks>
      {talks.map((t) => (
        <li data-year={t.year}>
          <a href={t.href} target="_blank" rel="noopener" class="group block">
            <div class="relative aspect-video overflow-hidden rounded-2xl border border-line bg-paper-2">
              <Img src={t.image} alt="" w={400} class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
              <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 font-mono text-xs">{t.year}</span>
            </div>
            <h3 class="mt-3 font-semibold group-hover:text-iris-700">{t.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Conversations -->
  <section class="container-page mt-28">
    <SectionHeader eyebrow="04 — In conversation" title="Podcasts & interviews" lead="Conversations on Ethereum's protocol, governance, community and what comes next." />
    <ul class="mt-12 divide-y divide-line border-y border-line">
      {conversations.map((c, i) => (
        <li>
          <a href={c.href} target="_blank" rel="noopener" class="group grid grid-cols-[auto_1fr_auto] items-center gap-4 py-5 sm:grid-cols-[3rem_9rem_1fr_auto] sm:gap-6">
            <span class="hidden font-mono text-sm text-muted sm:block">0{i + 1}</span>
            <Img src={c.image} alt="" w={144} class="aspect-video w-24 rounded-lg border border-line object-cover sm:w-36" />
            <div class="min-w-0">
              <h3 class="font-serif text-xl leading-tight sm:text-2xl group-hover:text-iris-700">{c.title}</h3>
              <p class="mt-1 text-sm text-muted">{c.host} · {c.length}</p>
            </div>
            <Icon name="arrow-up-right" size={20} class="text-muted transition-colors group-hover:text-iris-600" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Archive -->
  <section class="container-page mt-28">
    <SectionHeader eyebrow="05 — The archive" title="Press, writing & appearances" lead="A running collection of features, articles, talks and mentions." />
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {archive.map((group) => (
        <details class="card group overflow-hidden open:shadow-[0_18px_40px_-28px_rgb(22_23_29/0.4)]">
          <summary class="flex cursor-pointer list-none items-center gap-4 p-4 [&::-webkit-details-marker]:hidden">
            <Img src={group.image} alt="" w={112} class="aspect-video w-28 shrink-0 rounded-xl object-cover" />
            <div class="min-w-0 flex-1">
              <h3 class="font-serif text-2xl leading-tight">{group.title}</h3>
              <p class="mt-0.5 text-sm text-muted">{group.items.length} items</p>
            </div>
            <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line transition-transform group-open:rotate-45">
              <Icon name="plus" size={16} />
            </span>
          </summary>
          <ul class="border-t border-line px-4 py-2">
            {group.items.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noopener" class="flex items-start gap-3 rounded-lg px-2 py-2.5 text-[0.95rem] text-ink-2 hover:bg-paper hover:text-ink">
                  <Icon name={item.video ? "play" : "link"} size={14} class="mt-1 shrink-0 text-iris-600" />
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </section>

  <CtaBand title="Invite Pooja to speak" body="For talks, panels, podcasts and interviews on Ethereum governance, EIPs and community coordination, get in touch." />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-year]:is(button)");
  const items = document.querySelectorAll<HTMLElement>("[data-talks] > li");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const year = btn.dataset.year;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      items.forEach((li) => (li.hidden = year !== "all" && li.dataset.year !== year));
    }),
  );
</script>
