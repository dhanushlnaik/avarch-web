---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Img from "../components/Img.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CtaBand from "../components/CtaBand.astro";
import {
  projects,
  services,
  stats,
  testimonials,
  playlists,
  youtubePlaylists,
  ecosystemPartners,
  academicPartners,
} from "../data/site";
import { founder } from "../data/founder";

const [featured, ...rest] = projects.filter((p) => p.status !== "Archived");
const milestones = [...projects].sort((a, b) => Number(a.year) - Number(b.year));
const marquee = [...ecosystemPartners.map((p) => p.name), ...academicPartners.map((p) => p.name)];
---
<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="grain pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_70%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-48 left-1/2 size-[44rem] -translate-x-1/2 rounded-full bg-iris-200/50 blur-3xl" aria-hidden="true"></div>

    <div class="container-page relative grid items-center gap-14 pb-20 pt-16 sm:pt-24 lg:grid-cols-[1.15fr_1fr] lg:pb-28">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 py-1 pl-1 pr-3 text-sm text-ink-2">
          <span class="rounded-full bg-iris-600 px-2 py-0.5 text-xs font-medium text-white">New</span>
          BlobLens & EthShala are live
        </p>
        <h1 class="display mt-6 text-[3.4rem] sm:text-7xl lg:text-[5.4rem]">
          Tools, media &amp; education for <em class="text-iris-600">Ethereum.</em>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-2 sm:text-xl">
          Avarch is a blockchain software studio. Since 2017 we've built open analytics, published explainers read by
          thousands and helped the next generation of developers make their first contribution.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/projects" class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 font-medium text-paper transition-colors hover:bg-iris-700">
            Explore our projects <Icon name="arrow-right" size={18} />
          </a>
          <a href="/about" class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-surface px-6 py-3.5 font-medium text-ink transition-colors hover:border-ink">
            About Avarch
          </a>
        </div>
      </div>

      <!-- Product mosaic -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="grid grid-cols-2 gap-4">
          {projects.filter((p) => p.status !== "Archived").map((p, i) => (
            <a
              href={p.internal ?? p.href}
              target={p.internal ? undefined : "_blank"}
              rel={p.internal ? undefined : "noopener"}
              class:list={[
                "card group flex flex-col gap-6 p-5 transition-all hover:-translate-y-1 hover:border-iris-300 hover:shadow-[0_20px_40px_-24px_rgb(76_63_214/0.45)]",
                i % 2 === 1 && "translate-y-8",
              ]}
            >
              <div class="flex items-start justify-between">
                <Img src={p.logo} alt="" w={56} loading="eager" class="size-14 rounded-2xl border border-line bg-white object-contain p-1.5" />
                <Icon name="arrow-up-right" size={18} class="text-muted transition-colors group-hover:text-iris-600" />
              </div>
              <div>
                <p class="font-serif text-2xl leading-tight">{p.name}</p>
                <p class="mt-1 text-sm text-muted">{p.category}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="container-page relative">
      <dl class="grid grid-cols-2 divide-line rounded-[1.5rem] border border-line bg-surface md:grid-cols-4 md:divide-x">
        {stats.map((s, i) => (
          <div class:list={["p-6 sm:p-8", i < 2 && "border-b border-line md:border-b-0", i % 2 === 0 && "border-r border-line md:border-r-0"]}>
            <dt class="text-sm text-muted">{s.label}</dt>
            <dd class="display mt-2 text-5xl">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Partner marquee -->
  <section aria-label="Partners" class="mt-20 overflow-hidden border-y border-line bg-surface py-5">
    <div class="flex w-max animate-marquee gap-12 whitespace-nowrap hover:[animation-play-state:paused]">
      {[...marquee, ...marquee].map((name, i) => (
        <span class="flex items-center gap-12 font-serif text-2xl text-ink-2" aria-hidden={i >= marquee.length ? "true" : undefined}>
          {name}<span class="size-1.5 rounded-full bg-iris-300"></span>
        </span>
      ))}
    </div>
  </section>

  <!-- What we do -->
  <section class="container-page mt-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <SectionHeader
        eyebrow="01 — What we do"
        title="Making Ethereum <em>legible</em> for everyone."
        lead="We envision a growing ecosystem powered by good tooling, clear education and a steady pipeline of new contributors. Everything we build serves that goal."
      />
      <div class="grid gap-4 sm:grid-cols-2">
        {services.map((s) => (
          <div class="card p-6">
            <span class="grid size-11 place-items-center rounded-xl bg-iris-50 text-iris-600">
              <Icon name={s.icon} size={22} />
            </span>
            <h3 class="mt-5 text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-[0.95rem] text-ink-2">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="container-page mt-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeader eyebrow="02 — Portfolio" title="What we've built" lead="Open-source platforms and publications used across the Ethereum ecosystem." />
      <a href="/projects" class="inline-flex items-center gap-1.5 font-medium text-iris-700 hover:text-iris-900">
        All projects <Icon name="arrow-right" size={18} />
      </a>
    </div>
    <div class="mt-12 grid gap-5">
      <ProjectCard project={featured} featured />
      <div class="grid gap-5 md:grid-cols-3">
        {rest.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="mt-28 border-y border-line bg-surface py-20">
    <div class="container-page">
      <SectionHeader
        eyebrow="03 — Timeline"
        title="Nearly a decade of building"
        lead="From a single publication to a family of tools — each project grew out of a need we saw in the community."
      />
      <ol class="relative mt-14 grid gap-8 before:absolute before:left-[1.2rem] before:top-0 before:h-full before:w-px before:bg-line md:grid-cols-5 md:gap-4 md:before:left-0 md:before:top-[1.2rem] md:before:h-px md:before:w-full">
        {milestones.map((p) => (
          <li class="relative pl-14 md:pl-0 md:pt-16">
            <Img src={p.logo} alt="" w={40} class="absolute left-0 top-0 size-10 rounded-full border-2 border-surface bg-white object-contain p-0.5 shadow-[0_0_0_1px_var(--color-line)]" />
            <p class="font-mono text-sm text-iris-600">{p.year}</p>
            <h3 class="mt-1 font-serif text-2xl">{p.name}</h3>
            <p class="mt-1.5 text-sm text-ink-2">{p.summary}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Founder -->
  <section class="container-page mt-28">
    <div class="grid items-center gap-10 overflow-hidden rounded-[2rem] border border-line bg-gradient-to-br from-iris-50 via-paper to-ember-100/40 md:grid-cols-[0.9fr_1.1fr]">
      <div class="relative h-full min-h-80 self-stretch">
        <Img src={founder.cutout} alt="Portrait of Pooja Ranjan" w={480} class="absolute bottom-0 left-1/2 h-[95%] w-auto max-w-none -translate-x-1/2 object-contain object-bottom" />
      </div>
      <div class="px-6 pb-12 md:py-14 md:pr-14">
        <p class="eyebrow">04 — Leadership</p>
        <blockquote class="display mt-5 text-3xl sm:text-4xl">
          <span class="text-ember-500">“</span>{founder.quote}<span class="text-ember-500">”</span>
        </blockquote>
        <p class="mt-6 font-medium">{founder.name}</p>
        <p class="text-sm text-muted">{founder.role}</p>
        <a href="/founder" class="mt-8 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 font-medium text-paper transition-colors hover:bg-iris-700">
          Read Pooja's story <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- Learn -->
  <section class="container-page mt-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeader eyebrow="05 — Learn" title="Free courses on YouTube" lead="Video series that break down Ethereum and Web3 for developers and curious newcomers." />
      <a href={youtubePlaylists} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-medium text-iris-700 hover:text-iris-900">
        <Icon name="youtube" size={18} /> All playlists
      </a>
    </div>
    <ul class="mt-12 -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 [scrollbar-width:thin] md:mx-0 md:grid md:grid-cols-5 md:overflow-visible md:px-0">
      {playlists.map((pl) => (
        <li class="w-64 shrink-0 snap-start md:w-auto">
          <a href={youtubePlaylists} target="_blank" rel="noopener" class="group block">
            <div class="relative aspect-square overflow-hidden rounded-2xl border border-line">
              <Img src={pl.image} alt="" w={256} class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <span class="absolute bottom-3 right-3 grid size-10 place-items-center rounded-full bg-white/90 text-ink shadow-sm transition-colors group-hover:bg-iris-600 group-hover:text-white">
                <Icon name="play" size={16} />
              </span>
            </div>
            <h3 class="mt-4 font-semibold">{pl.title}</h3>
            <p class="mt-1 text-sm text-ink-2">{pl.body}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Testimonials -->
  <section class="container-page mt-28">
    <SectionHeader eyebrow="06 — Community" title="Trusted by the people building Ethereum" align="center" />
    <div class="mt-14 gap-5 sm:columns-2 lg:columns-3">
      {testimonials.map((t) => (
        <figure class="card mb-5 break-inside-avoid p-6">
          <blockquote class="text-[1.05rem] leading-relaxed text-ink">“{t.quote}”</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <Img src={t.avatar} alt="" w={40} class="size-10 rounded-full border border-line object-cover" />
            <div class="min-w-0">
              <p class="text-sm font-semibold">{t.name}</p>
              <p class="text-xs text-muted">{t.role}</p>
            </div>
            <a href={t.href} target="_blank" rel="noopener" class="ml-auto grid size-9 place-items-center rounded-full text-muted hover:bg-paper-2 hover:text-ink" aria-label={`View ${t.name}'s post on X`}>
              <Icon name="x" size={15} />
            </a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand />
</Layout>
