---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site, socials } from "../data/site";

const topics = ["Project development", "Research & consulting", "Partnership", "Internships", "Speaking & media", "Something else"];
const inputClass =
  "mt-2 block w-full rounded-xl border border-line-strong bg-paper/50 px-4 py-3 text-base text-ink placeholder:text-muted/70 transition-colors focus:border-iris-600 focus:bg-surface focus:outline-none focus:ring-4 focus:ring-iris-100";
---
<Layout title="Contact" description="Get in touch with Avarch about blockchain project development, research, partnerships, internships or speaking.">
  <section class="relative overflow-hidden">
    <div class="grain pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent_60%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-40 -top-40 size-[34rem] rounded-full bg-iris-200/50 blur-3xl" aria-hidden="true"></div>

    <div class="container-page relative grid gap-14 pb-8 pt-16 sm:pt-24 lg:grid-cols-[1fr_1.15fr]">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="display mt-4 text-5xl sm:text-7xl">Let's build <em class="text-iris-600">together.</em></h1>
        <p class="mt-6 max-w-lg text-lg text-ink-2">
          Avarch develops blockchain products, conducts research, supports developer communities and collaborates with institutions across the ecosystem. Whether it's a project, a partnership or a question — we'd like to hear from you.
        </p>

        <dl class="mt-10 space-y-6">
          <div>
            <dt class="eyebrow !text-muted">Email</dt>
            <dd class="mt-2">
              <a href={`mailto:${site.email}`} class="font-serif text-3xl underline decoration-iris-300 underline-offset-[6px] hover:decoration-iris-600">{site.email}</a>
            </dd>
          </div>
          <div>
            <dt class="eyebrow !text-muted">Elsewhere</dt>
            <dd class="mt-3">
              <ul class="flex flex-wrap gap-2">
                {socials.map((s) => (
                  <li>
                    <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm text-ink-2 transition-colors hover:border-ink hover:text-ink">
                      <Icon name={s.icon} size={15} /> {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </div>

      <form class="card p-6 shadow-[0_30px_60px_-45px_rgb(22_23_29/0.45)] sm:p-9" data-contact-form novalidate>
        <fieldset>
          <legend class="text-sm font-medium">What's this about?</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {topics.map((t, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="topic" value={t} checked={i === 0} class="peer sr-only" />
                <span class="inline-block rounded-full border border-line-strong px-3.5 py-2 text-sm text-ink-2 transition-colors peer-checked:border-ink peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:ring-4 peer-focus-visible:ring-iris-100">{t}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-7 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required placeholder="Ada Lovelace…" class={inputClass} />
          </div>
          <div>
            <label for="email" class="text-sm font-medium">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" spellcheck="false" required placeholder="ada@example.com" class={inputClass} />
          </div>
        </div>
        <div class="mt-5">
          <label for="org" class="text-sm font-medium">Organisation <span class="font-normal text-muted">(optional)</span></label>
          <input id="org" name="org" type="text" autocomplete="organization" placeholder="University, DAO or company…" class={inputClass} />
        </div>
        <div class="mt-5">
          <label for="message" class="text-sm font-medium">Message</label>
          <textarea id="message" name="message" rows="5" required placeholder="Tell us a little about what you're working on…" class={inputClass}></textarea>
        </div>

        <p class="mt-4 hidden text-sm text-ember-600" role="alert" data-error></p>

        <button type="submit" class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-full bg-iris-600 px-6 py-3.5 font-medium text-white transition-colors hover:bg-iris-700">
          Send message <Icon name="arrow-right" size={18} />
        </button>
        <p class="mt-3 text-center text-xs text-muted">Opens your email app with the message ready to send.</p>
      </form>
    </div>
  </section>
</Layout>

<script define:vars={{ email: site.email }}>
  const form = document.querySelector("[data-contact-form]");
  const error = form.querySelector("[data-error]");
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const missing = ["name", "email", "message"].find((k) => !String(data.get(k) || "").trim());
    const emailOk = form.email.validity.valid;
    if (missing || !emailOk) {
      const field = missing ? form[missing] : form.email;
      error.textContent = missing ? `Please fill in your ${missing}.` : "Please enter a valid email address.";
      error.classList.remove("hidden");
      field.focus();
      return;
    }
    error.classList.add("hidden");
    const subject = `[${data.get("topic")}] from ${data.get("name")}`;
    const body = [
      data.get("message"),
      "",
      "—",
      `${data.get("name")} <${data.get("email")}>`,
      data.get("org") ? String(data.get("org")) : "",
    ].join("\n");
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
